# Development-only credentials. Change these before deploying anywhere public.
POSTGRES_USER=mf_admin
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=mf_tracker
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_API_URL=http://backend:8000

# Use a long, unique value outside local development. It signs login tokens.
JWT_SECRET=replace_with_a_long_random_secret_before_production_8n1pKqvY2mLsR7x
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# AMFI publishes end-of-day NAVs; the worker checks this source every 6 hours.
AMFI_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt
NAV_REFRESH_INTERVAL_SECONDS=21600
